# =========================================================================
#  NARA AC - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
#  Salin berkas ini ke .env di root / server Anda sebelum menjalankan:
#  cp .env.production.example .env
# =========================================================================

# --- 1. Konfigurasi Port & HTTP ---
PORT_HTTP=80

# --- 2. Database PostgreSQL ---
POSTGRES_DB=nara_ac
POSTGRES_USER=nara_user
DB_PASSWORD=GantiDenganPasswordDatabaseYangSangatKuat2026!

# --- 3. Autentikasi JWT (Wajib acak minimal 32 karakter) ---
JWT_SECRET=GantiDenganStringAcakMinimal32KarakterUntukKeamananTokenJWTProduction2026!
JWT_EXPIRES_IN=24h

# --- 4. Password Default Akun Admin Pertama ---
# Digunakan saat database pertama kali diinisialisasi (username: admin)
DEMO_PASSWORD=AdminNara2026!SangatKuat

# --- 5. Keamanan Internal AI Microservice ---
AI_API_KEY=KunciOtentikasiInternalBackendKeAIService2026!
AI_CONFIDENCE_THRESHOLD=0.55
AI_TIMEOUT_MS=6000

# --- 6. Kebijakan CORS (Domain Web Produksi Anda) ---
# Pisahkan dengan koma jika lebih dari satu domain
CORS_ORIGINS=https://narateknindotama.com,https://www.narateknindotama.com,https://ac.nara.co.id

# --- 7. WhatsApp Gateway (Meta Cloud API / Fonnte) ---
# Ubah WHATSAPP_MODE ke "production" jika sudah memiliki token
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# --- 8. Google Gemini LLM API (Opsional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- 9. Background Scheduler (Pengingat Service Servis AC Harian) ---
SCHEDULER_ENABLED=true

