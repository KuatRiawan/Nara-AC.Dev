# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/nara_ac

# Authentication (Use at least 32 random characters in production)
JWT_SECRET=replace_with_strong_32_byte_jwt_secret_key
JWT_EXPIRES_IN=24h

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_CONFIDENCE_THRESHOLD=0.55
AI_TIMEOUT_MS=6000

# WhatsApp Gateway & Webhook Security
WHATSAPP_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=replace_with_webhook_hmac_secret

# Other Services
TELEGRAM_BOT_TOKEN=
SCHEDULER_ENABLED=true
DEMO_PASSWORD=

# Google Gemini AI Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
